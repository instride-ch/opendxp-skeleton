{% set nav_start_node = document.property('nav_start_node')|default(opendxp_document(1)) %}
{% set navigation = opendxp_build_nav({'active': document, 'root': nav_start_node}) %}
{% set menu_renderer = opendxp_nav_renderer('menu') %}

<header class="bg-white">
    <nav aria-label="Global" class="mx-auto flex max-w-7xl items-center justify-between p-6 lg:px-8">
        <div class="flex lg:flex-1">
            <a href="{{ nav_start_node }}" class="-m-1.5 p-1.5">
                {% if opendxp_website_config('name') is not empty -%}
                    <span class="sr-only">{{ opendxp_website_config('name') }}</span>
                {% endif %}
                <img src="{{ asset('assets/images/logo.svg', 'vite') }}" alt="" class="h-8 w-auto" />
            </a>
        </div>
        <div class="flex lg:hidden">
            <button type="button" command="show-modal" commandfor="mobile-menu" class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-gray-700">
                <span class="sr-only">{{ 'app.base.header.open_menu'|trans }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
                    <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </div>
        <div class="hidden lg:flex lg:gap-x-12">
            {% for page in navigation|filter(page => page.isVisible and menu_renderer.accept(page)) %}
                <a href="{{ page.href }}" class="text-sm/6 font-semibold text-gray-900{{ page.isActive(true) ? ' underline underline-offset-2' }}">
                    {{- page.label -}}
                </a>
            {% endfor %}
        </div>
        <div class="hidden lg:flex lg:flex-1 lg:justify-end">
            <a href="{{ path('app_login') }}" class="text-sm/6 font-semibold text-gray-900" target="_blank">
                {{- 'app.base.header.login'|trans }} <span aria-hidden="true">&rarr;</span>
            </a>
        </div>
    </nav>
    <dialog id="mobile-menu" class="backdrop:bg-transparent lg:hidden">
        <div tabindex="0" class="fixed inset-0 focus:outline-none">
            <div class="fixed inset-y-0 right-0 z-50 w-full overflow-y-auto bg-white p-6 sm:max-w-sm sm:ring-1 sm:ring-gray-900/10">
                <div class="flex items-center justify-between">
                    <a href="{{ nav_start_node }}" class="-m-1.5 p-1.5">
                        {% if opendxp_website_config('name') is not empty %}
                            <span class="sr-only">{{ opendxp_website_config('name') }}</span>
                        {% endif %}
                        <img src="{{ asset('assets/images/logo.svg', 'vite') }}" alt="" class="h-8 w-auto" />
                    </a>
                    <button type="button" command="close" commandfor="mobile-menu" class="-m-2.5 rounded-md p-2.5 text-gray-700">
                        <span class="sr-only">{{ 'app.base.header.close_menu'|trans }}</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
                            <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                </div>
                <div class="mt-6 flow-root">
                    <div class="-my-6 divide-y divide-gray-500/10">
                        <div class="space-y-2 py-6">
                            {% for page in navigation|filter(page => page.isVisible and menu_renderer.accept(page)) %}
                                <a href="{{ page.href }}" class="-mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-gray-900 hover:bg-gray-50{{ page.isActive(true) ? ' underline underline-offset-2' }}">
                                    {{- page.label -}}
                                </a>
                            {% endfor %}
                        </div>
                        <div class="py-6">
                            <a href="{{ path('app_login') }}" class="-mx-3 block rounded-lg px-3 py-2.5 text-base/7 font-semibold text-gray-900 hover:bg-gray-50" target="_blank">
                                {{- 'app.base.header.login'|trans -}}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </dialog>
</header>
