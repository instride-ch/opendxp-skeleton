{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "ignorePatterns": [
    "public/build/**",
    "public/bundles/**",
    "var/**",
    "vendor/**",
    "lib/**",
    "tests/**"
  ]
}
